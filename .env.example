# ============================================
# GlassMind — Environment Variables Template
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================

# ---- General ----
NODE_ENV=development
DEBUG=true

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=GlassMind
NEXT_PUBLIC_APP_VERSION=0.1.0

# ---- Backend ----
APP_NAME=glassmind
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://glassmind:glassmind@localhost:5432/glassmind
POSTGRES_USER=glassmind
POSTGRES_PASSWORD=glassmind
POSTGRES_DB=glassmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Qdrant (Vector DB) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- AI / LLM ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000
